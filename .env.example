# -----------------------------------------------------------------------------
# 1. UI & Theming Configuration
# -----------------------------------------------------------------------------
# APP_THEME controls the primary color scheme of the application.
# Available themes: blue, orange, violet, green, grey (Defaults to "blue" if empty)
APP_THEME="violet"

# APP_CORNER controls the border-radius (roundness) of cards and buttons.
# Available corners: sharp, normal, curved (Defaults to "normal" if empty)
APP_CORNER="normal"

# TAGLINE_ICON controls the small icon displayed next to the tagline.
# Available icons: rocket, star, bolt, bell, sparkles (Defaults to "rocket" if empty)
TAGLINE_ICON="sparkles"


# -----------------------------------------------------------------------------
# 2. Page Content
# Note: Remove any of these variables to gracefully hide them from the UI.
# -----------------------------------------------------------------------------
# TAGLINE appears as a small badge above the main heading.
TAGLINE="Launching Soon"

# HEADING is the large primary text of the landing page.
HEADING="The Future of Work is Almost Here"

# DESCRIPTION provides secondary text below the main heading.
DESCRIPTION="Get ready to experience a seamless, AI-driven workflow that adapts to you."

# TARGET_DATE sets the countdown timer.
TARGET_DATE="2026-12-31T23:59:59.000Z"


# -----------------------------------------------------------------------------
# 3. SEO & Metadata
# Note: These values populate your <head> tags. Omit them to leave tags empty.
# -----------------------------------------------------------------------------
# APP_URL sets the application URL / domain (e.g. http://192.168.1.39:8888 or https://myapp.com)
APP_URL="http://localhost:8888"

# APP_NAME sets the <title> of the page.
APP_NAME="My App"

# APP_DESC sets the <meta name="description"> for search engines.
APP_DESC="My App Description"

# APP_FAVICON_URL sets the small icon shown in the browser tab.
APP_FAVICON_URL="https://example.com/favicon.ico"

# APP_OG_IMAGE_URL sets the preview image shown when the link is shared on social media.
APP_OG_IMAGE_URL="https://example.com/og-image.jpg"
